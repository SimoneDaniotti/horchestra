# Records docs/images/demo.gif:  vhs tools/demo/demo.tape   (from the repo root)
Output docs/images/demo.gif

Set Shell "bash"
Set FontSize 17
Set Width 1040
Set Height 700
Set Padding 16
Set Framerate 12
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0

Hide
Type "clear && python3 tools/demo/run_demo.py" Enter
Sleep 1.2s
Type "i"
Show
Sleep 27s
Hide
Type "q"
