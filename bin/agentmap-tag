#!/usr/bin/env python3
"""Tag a child agent pane so the agent map draws it under its orchestrator.

Run from the orchestrator's own pane right after launching a child:

    agentmap-tag w1:p4 --role FE
    agentmap-tag w1:p4 --role FE --parent w1:p1   # explicit parent
    agentmap-tag w1:p4 --clear

The parent defaults to the calling pane ($HERDR_PANE_ID). It is stored as the
parent's terminal_id, which survives pane moves across tabs and workspaces.
"""

import argparse
import os
import sys

sys.path.insert(
    0, os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
)

import herdr_client as hc  # noqa: E402


def main():
    parser = argparse.ArgumentParser(prog="agentmap-tag", description=__doc__.splitlines()[0])
    parser.add_argument("pane", help="child pane id, e.g. w1:p4")
    parser.add_argument("--role", help="short label shown in the map (max 80 chars)")
    parser.add_argument("--parent", help="parent pane id (default: $HERDR_PANE_ID)")
    parser.add_argument("--clear", action="store_true", help="remove agent map tags")
    args = parser.parse_args()

    try:
        if args.clear:
            hc.set_tokens(args.pane, clear=[hc.TOKEN_PARENT, hc.TOKEN_ROLE])
            return 0
        parent_id = args.parent or os.environ.get("HERDR_PANE_ID")
        if not parent_id:
            parser.error("--parent is required outside a Herdr pane")
        parent = hc.get_pane(parent_id)
        parent_ref = parent.get("terminal_id") or parent.get("pane_id") or parent_id
        tokens = {hc.TOKEN_PARENT: parent_ref}
        if args.role:
            tokens[hc.TOKEN_ROLE] = args.role
        hc.set_tokens(args.pane, tokens)
    except hc.HerdrError as exc:
        print(f"agentmap-tag: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
