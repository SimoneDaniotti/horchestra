#!/usr/bin/env python3
"""Deprecated alias for horchestra-tag (renamed in 0.1); kept for one version."""

import os
import sys

target = os.path.join(os.path.dirname(os.path.realpath(__file__)), "horchestra-tag")
print("note: agentmap-tag is now horchestra-tag; the old name will be removed", file=sys.stderr)
os.execv(sys.executable, [sys.executable, target, *sys.argv[1:]])
