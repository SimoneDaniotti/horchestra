            "placement": "split",
            "title": "horchestra-overview"
          }
        ],
        "platforms": [
          "linux",
          "macos"
        ],
        "plugin_id": "horchestra",
        "plugin_root": "/home/user/src/horchestra",
        "source": {
          "kind": "local"
        },
        "startup": [
          {
            "command": [
              "python3",
              "team.py",
              "restore"
